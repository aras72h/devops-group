# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this to .env and fill in the values
#
#   cp .env.example .env
#
# .env is listed in .gitignore and must NEVER be committed.
# This file (.env.example) IS committed — it documents what variables exist
# without exposing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=notes
DB_USER=notes_user
DB_PASSWORD=change_me_please

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# Port exposed on your laptop (http://localhost:4000)
FRONTEND_PORT=4000

# ── Monitoring ────────────────────────────────────────────────────────────────
# Grafana web UI — http://localhost:4001
GRAFANA_PORT=4001
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_please

# Locust web UI — http://localhost:4002
LOCUST_PORT=4002

# ── Production only ───────────────────────────────────────────────────────────
# The registry prefix for pre-built images.
# Example: ghcr.io/acme/team-notes
REGISTRY=ghcr.io/your-org/team-notes

# Git SHA of the images to deploy (set automatically by CI, override manually)
IMAGE_TAG=latest

